@model Biblioteca.Web.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="alert alert-danger shadow-sm mt-4 border-0 rounded-4 p-4 text-center">
            <h4 class="alert-heading fw-bold mb-3">¿Estás seguro de que deseas eliminar este libro?</h4>
            <p class="mb-0 fs-5 text-dark">Estás a punto de eliminar lógicamente el libro <strong>@Model.Titulo</strong>.</p>
        </div>

        <div class="card shadow border-0 rounded-4 mt-4">
            <div class="card-body p-5">
                <dl class="row mb-0 fs-5">
                    <dt class="col-sm-4 text-muted fw-normal">Título</dt>
                    <dd class="col-sm-8 fw-medium">@Model.Titulo</dd>

                    <dt class="col-sm-4 text-muted fw-normal mt-3">Autor</dt>
                    <dd class="col-sm-8 fw-medium mt-3">@Model.AutorNombre</dd>

                    <dt class="col-sm-4 text-muted fw-normal mt-3">ISBN</dt>
                    <dd class="col-sm-8 fw-medium mt-3">@Model.ISBN</dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-4 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="text-decoration-none text-muted fw-medium">Cancelar y volver</a>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="LibroId" />
                    <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 shadow-sm">Sí, Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>
