@model Biblioteca.Web.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0 rounded-4 mt-4">
            <div class="card-header bg-warning text-dark text-center py-3 rounded-top-4">
                <h3 class="mb-0 fw-bold">@ViewData["Title"]</h3>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="LibroId" />
                    
                    <div class="mb-4">
                        <label asp-for="Titulo" class="form-label fw-semibold text-secondary"></label>
                        <input asp-for="Titulo" class="form-control form-control-lg rounded-3 bg-light border-0" />
                        <span asp-validation-for="Titulo" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="ISBN" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="ISBN" class="form-control form-control-lg rounded-3 bg-light border-0" />
                            <span asp-validation-for="ISBN" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6 mt-4 mt-md-0">
                            <label asp-for="AutorId" class="form-label fw-semibold text-secondary"></label>
                            <select asp-for="AutorId" class="form-select form-select-lg rounded-3 bg-light border-0" asp-items="ViewBag.Autores"></select>
                            <span asp-validation-for="AutorId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Ejemplares" class="form-label fw-semibold text-secondary"></label>
                        <input asp-for="Ejemplares" class="form-control form-control-lg rounded-3 bg-light border-0" />
                        <span asp-validation-for="Ejemplares" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5">
                        <a asp-action="Index" class="text-decoration-none text-muted fw-medium">
                            Volver al listado
                        </a>
                        <button type="submit" class="btn btn-warning btn-lg px-5 rounded-pill shadow-sm">
                            Actualizar Libro
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
