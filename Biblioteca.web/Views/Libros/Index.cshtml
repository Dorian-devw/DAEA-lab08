@model IEnumerable<Biblioteca.Web.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up">
    <h1 class="display-6 fw-bold text-primary">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-success shadow-sm rounded-pill px-4">
        Nuevo Libro
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4 bg-light animate-fade-in-up delay-1">
    <div class="card-body">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="buscar" value="@ViewData["Buscar"]" class="form-control rounded-pill px-4" placeholder="Buscar por título..." />
            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Limpiar</a>
        </form>
    </div>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm border overflow-hidden animate-fade-in-up delay-2">
    <table class="table table-hover table-borderless align-middle mb-0">
        <thead class="table-light border-bottom">
            <tr>
                <th class="ps-4">Título</th>
                <th>Autor</th>
                <th>ISBN</th>
                <th>Ejemplares</th>
                <th class="text-end pe-4">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <partial name="_LibroRow" model="item" />
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="text-center p-5 text-muted">
            <p class="mb-0 fs-5">No se encontraron libros.</p>
        </div>
    }
</div>
