@model IEnumerable<Biblioteca.Web.Models.Socio>

@{
    ViewData["Title"] = "Directorio de Socios";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up">
    <h1 class="display-6 fw-bold text-primary">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-success shadow-sm rounded-pill px-4">
        Nuevo Socio
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive bg-white rounded-3 shadow-sm border overflow-hidden animate-fade-in-up delay-1">
    <table class="table table-hover table-borderless align-middle mb-0">
        <thead class="table-light border-bottom">
            <tr>
                <th class="ps-4">DNI</th>
                <th>Nombre</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-4 fw-medium text-dark">@item.DNI</td>
                    <td class="text-secondary">@item.Nombre</td>
                    <td class="text-muted"><a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a></td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="text-center p-5 text-muted">
            <p class="mb-0 fs-5">No se encontraron socios registrados.</p>
        </div>
    }
</div>
