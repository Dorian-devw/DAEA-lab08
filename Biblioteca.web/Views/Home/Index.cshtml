@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-5 animate-fade-in-up">
    <div class="row align-items-center rounded-4 shadow-lg overflow-hidden" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white;">
        <div class="col-lg-7 p-5">
            <h1 class="display-4 fw-bold mb-3">Gestión de Biblioteca</h1>
            <p class="lead mb-4 opacity-75">
                Bienvenido al sistema de administración de biblioteca. Aquí puedes gestionar el catálogo de libros, 
                mantener el registro de socios y generar reportes detallados de los préstamos.
            </p>
            <div class="d-flex gap-3">
                <a asp-controller="Libros" asp-action="Index" class="btn btn-light btn-lg rounded-pill px-4 shadow-sm text-primary fw-bold">
                    <i class="bi bi-book me-2"></i> Ver Libros
                </a>
                <a asp-controller="Socios" asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill px-4">
                    <i class="bi bi-people me-2"></i> Ver Socios
                </a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block p-0 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="250" height="250" fill="currentColor" class="bi bi-book-half text-white opacity-50" viewBox="0 0 16 16" style="margin: 3rem;">
              <path d="M8.5 2.687c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
            </svg>
        </div>
    </div>
    
    <div class="row mt-5 g-4">
        <div class="col-md-4 animate-fade-in-up delay-1">
            <a asp-controller="Libros" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 rounded-4 hover-card">
                    <div class="card-body p-4 text-center">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-journal-text text-primary" viewBox="0 0 16 16">
                              <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                              <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2z"/>
                              <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1z"/>
                            </svg>
                        </div>
                        <h4 class="fw-bold text-dark">Gestión de Libros</h4>
                        <p class="text-muted mb-0">Añade nuevos títulos, actualiza los ejemplares y mantén el catálogo al día.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4 animate-fade-in-up delay-2">
            <a asp-controller="Socios" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 rounded-4 hover-card">
                    <div class="card-body p-4 text-center">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-person-badge text-success" viewBox="0 0 16 16">
                              <path d="M6.5 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1h-3zM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                              <path d="M4.5 0A2.5 2.5 0 0 0 2 2.5V14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2.5A2.5 2.5 0 0 0 11.5 0h-7zM3 2.5A1.5 1.5 0 0 1 4.5 1h7A1.5 1.5 0 0 1 13 2.5v10.795a4.2 4.2 0 0 0-.776-.492C11.392 12.387 10.063 12 8 12s-3.392.387-4.224.803a4.2 4.2 0 0 0-.776.492V2.5z"/>
                            </svg>
                        </div>
                        <h4 class="fw-bold text-dark">Gestión de Socios</h4>
                        <p class="text-muted mb-0">Registra a los miembros de la biblioteca de manera sencilla y segura.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4 animate-fade-in-up delay-3">
            <a asp-controller="Prestamos" asp-action="Reporte" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 rounded-4 hover-card">
                    <div class="card-body p-4 text-center">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-calendar-check text-warning" viewBox="0 0 16 16">
                              <path d="M10.854 7.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 9.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                              <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                            </svg>
                        </div>
                        <h4 class="fw-bold text-dark">Reporte de Préstamos</h4>
                        <p class="text-muted mb-0">Consulta fácilmente qué libros han sido prestados en fechas específicas.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
